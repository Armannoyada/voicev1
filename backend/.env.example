# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://voicev1:voicev1_dev_password@localhost:5432/voicev1?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- LiveKit mode: "selfhosted" | "cloud" ---
LIVEKIT_MODE=selfhosted

# --- Self-hosted LiveKit (from docker-compose) ---
LIVEKIT_SELFHOSTED_URL=ws://localhost:7880
LIVEKIT_SELFHOSTED_API_KEY=devkey
LIVEKIT_SELFHOSTED_API_SECRET=devsecret_change_me_in_production_at_least_32_chars

# --- LiveKit Cloud (fill in if you switch LIVEKIT_MODE=cloud) ---
LIVEKIT_CLOUD_URL=
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
